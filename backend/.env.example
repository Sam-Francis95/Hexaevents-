MONGO_URI=mongodb://localhost:27017/smartevent

JWT_SECRET_KEY=change-this-to-a-real-secret
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=604800

# Create this in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=

# Works with Gmail SMTP, SendGrid, or Hexaware's real corporate SMTP relay.
# Leave SMTP_HOST empty in dev -- the mailer will log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@smartevent.ai

# none | openai | azure -- leave as "none" until credentials are ready.
LLM_PROVIDER=none
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

CORS_ORIGINS=http://localhost:5173
